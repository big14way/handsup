{
  "name": "handsup-glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && node scripts/release-manifest.mjs && evenhub pack release/app.json dist -o handsup.ehpk",
    "simulate": "evenhub-simulator --automation-port 9898 http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
