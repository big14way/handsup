# Neon Postgres connection string
DATABASE_URL=
# Set to 1 only for local development: enables /api/dev/* and unsigned Mini App users
DEV_AUTH=0
PORT=8787
# Telegram bot token from @BotFather
BOT_TOKEN=
# Any random string; Telegram sends it back with each webhook call (production only)
TELEGRAM_WEBHOOK_SECRET=
# Claude: merges duplicate questions, shortens them for the lens, summarises spoken answers
ANTHROPIC_API_KEY=
# Groq Whisper: transcribes the host's spoken answer
GROQ_API_KEY=
